{
  "name": "agstatus-dashboard",
  "version": "1.6.2",
  "private": true,
  "license": "MIT",
  "description": "AgStatus — webhook-driven status dashboard for Claude Code and Codex agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KardanovIR/agstatus.git"
  },
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "build:docs": "node scripts/build-docs.js",
    "sync:plugin": "cp cli/assets/agstatus-hook.js plugin/scripts/agstatus-hook.js",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^6.0.2",
    "better-sqlite3": "^11.10.0",
    "jsdom": "^26.1.0",
    "marked": "^18.0.10",
    "supertest": "^7.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.8"
  }
}
